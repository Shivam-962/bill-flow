# ==================================================
# BillFlow ERP - Environment Settings Template
# ==================================================

# 1. Supabase Postgres Configuration
# Get these from your Supabase Project Settings API Tab
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 2. WhatsApp Cloud API Integrations
# Generate these under Meta Developer Portal -> WhatsApp -> Setup
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_DEVELOPER_TOKEN=your-meta-system-user-access-token
WHATSAPP_API_VERSION=v19.0

# 3. Razorpay SaaS Checkout keys
# Get these under Razorpay Dashboard Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
